generator client {
  provider     = "prisma-client"
  output       = "../generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

model User {
  id        String   @id @default(uuid())
  name      String
  email     String   @unique
  password  String
  role      Role     @default(USER)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("users")
}

enum Role {
  ADMIN
  USER
}

model Client {
  id        String      @id @default(uuid())
  type      ClientType  @default(INDIVIDUAL)
  name      String
  document  String      @unique
  email     String?
  phone     String?
  address   String?
  city      String?
  state     String?
  zipCode   String?
  notes     String?
  budgets   Budget[]
  workSites WorkSite[]
  projects  Project[]
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  @@map("clients")
}

enum ClientType {
  INDIVIDUAL
  COMPANY
}

model Material {
  id          String               @id @default(uuid())
  code        String?              @unique
  name        String
  category    String
  unit        String
  unitCost    Decimal              @db.Decimal(12, 2)
  supplier    String?
  budgetItems BudgetMaterialItem[]
  stockItem   StockItem?
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt

  @@map("materials")
}

model LaborRole {
  id          String            @id @default(uuid())
  name        String            @unique
  hourlyRate  Decimal           @db.Decimal(12, 2)
  chargesPct  Decimal           @db.Decimal(5, 2) @default(0)
  budgetItems BudgetLaborItem[]
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  @@map("labor_roles")
}

model Vehicle {
  id             String             @id @default(uuid())
  name           String
  plate          String             @unique
  type           String
  fuelType       String
  avgConsumption Decimal            @db.Decimal(6, 2)
  budgetItems    BudgetTravelItem[]
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  @@map("vehicles")
}

enum BudgetStatus {
  DRAFT
  SENT
  APPROVED
  REJECTED
  NEGOTIATING
}

enum TaxRegime {
  SIMPLES
  LUCRO_PRESUMIDO
  LUCRO_REAL
  MEI
}

model Budget {
  id            String               @id @default(uuid())
  number        String               @unique
  clientId      String
  client        Client               @relation(fields: [clientId], references: [id])
  description   String?
  status        BudgetStatus         @default(DRAFT)
  regime        TaxRegime            @default(SIMPLES)
  bdiPct        Decimal              @db.Decimal(5, 2) @default(20)
  discountPct   Decimal              @db.Decimal(5, 2) @default(0)
  notes         String?
  materialItems BudgetMaterialItem[]
  laborItems    BudgetLaborItem[]
  travelItems   BudgetTravelItem[]
  otherItems    BudgetOtherItem[]
  project       Project?
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt

  @@map("budgets")
}

model BudgetMaterialItem {
  id         String   @id @default(uuid())
  budgetId   String
  budget     Budget   @relation(fields: [budgetId], references: [id], onDelete: Cascade)
  materialId String
  material   Material @relation(fields: [materialId], references: [id])
  quantity   Decimal  @db.Decimal(12, 2)
  unitCost   Decimal  @db.Decimal(12, 2)

  @@map("budget_material_items")
}

model BudgetLaborItem {
  id          String    @id @default(uuid())
  budgetId    String
  budget      Budget    @relation(fields: [budgetId], references: [id], onDelete: Cascade)
  laborRoleId String
  laborRole   LaborRole @relation(fields: [laborRoleId], references: [id])
  hours       Decimal   @db.Decimal(8, 2)
  hourlyRate  Decimal   @db.Decimal(12, 2)

  @@map("budget_labor_items")
}

model BudgetTravelItem {
  id         String  @id @default(uuid())
  budgetId   String
  budget     Budget  @relation(fields: [budgetId], references: [id], onDelete: Cascade)
  vehicleId  String
  vehicle    Vehicle @relation(fields: [vehicleId], references: [id])
  distanceKm Decimal @db.Decimal(10, 2)
  trips      Int
  fuelPrice  Decimal @db.Decimal(8, 2)

  @@map("budget_travel_items")
}

model BudgetOtherItem {
  id          String  @id @default(uuid())
  budgetId    String
  budget      Budget  @relation(fields: [budgetId], references: [id], onDelete: Cascade)
  description String
  amount      Decimal @db.Decimal(12, 2)

  @@map("budget_other_items")
}

model WorkSite {
  id         String    @id @default(uuid())
  name       String
  clientId   String
  client     Client    @relation(fields: [clientId], references: [id])
  address    String
  city       String?
  state      String?
  distanceKm Decimal?  @db.Decimal(10, 2)
  notes      String?
  projects   Project[]
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@map("work_sites")
}

enum ProjectStatus {
  PLANNING
  IN_PROGRESS
  ON_HOLD
  COMPLETED
  CANCELLED
}

model Project {
  id                 String          @id @default(uuid())
  number             String          @unique
  name               String
  clientId           String
  client             Client          @relation(fields: [clientId], references: [id])
  workSiteId         String?
  workSite           WorkSite?       @relation(fields: [workSiteId], references: [id])
  budgetId           String?         @unique
  budget             Budget?         @relation(fields: [budgetId], references: [id])
  status             ProjectStatus   @default(PLANNING)
  budgetAmount       Decimal         @db.Decimal(12, 2) @default(0)
  startDate          DateTime?
  endDate            DateTime?
  notes              String?
  toolsCurrentlyHere Tool[]
  toolMovements      ToolMovement[]
  stockMovements     StockMovement[]
  workLogs           WorkLog[]
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt

  @@map("projects")
}

enum ToolLocation {
  COMPANY
  PROJECT
}

model Tool {
  id               String         @id @default(uuid())
  code             String?        @unique
  name             String
  category         String
  currentLocation  ToolLocation   @default(COMPANY)
  currentProjectId String?
  currentProject   Project?       @relation(fields: [currentProjectId], references: [id])
  notes            String?
  movements        ToolMovement[]
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  @@map("tools")
}

model ToolMovement {
  id           String       @id @default(uuid())
  toolId       String
  tool         Tool         @relation(fields: [toolId], references: [id], onDelete: Cascade)
  fromLocation ToolLocation
  toLocation   ToolLocation
  projectId    String?
  project      Project?     @relation(fields: [projectId], references: [id])
  responsible  String?
  notes        String?
  movedAt      DateTime     @default(now())

  @@map("tool_movements")
}

enum StockMovementType {
  IN
  OUT
}

model StockItem {
  id          String          @id @default(uuid())
  materialId  String          @unique
  material    Material        @relation(fields: [materialId], references: [id])
  quantity    Decimal         @db.Decimal(12, 2) @default(0)
  minQuantity Decimal         @db.Decimal(12, 2) @default(0)
  movements   StockMovement[]
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  @@map("stock_items")
}

model StockMovement {
  id          String            @id @default(uuid())
  stockItemId String
  stockItem   StockItem         @relation(fields: [stockItemId], references: [id], onDelete: Cascade)
  type        StockMovementType
  quantity    Decimal           @db.Decimal(12, 2)
  projectId   String?
  project     Project?          @relation(fields: [projectId], references: [id])
  notes       String?
  movedAt     DateTime          @default(now())

  @@map("stock_movements")
}

model WorkLog {
  id              String   @id @default(uuid())
  projectId       String
  project         Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  date            DateTime
  weather         String?
  workersPresent  Int?
  description     String
  occurrences     String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@map("work_logs")
}