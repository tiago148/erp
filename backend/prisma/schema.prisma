generator client {
  provider     = "prisma-client"
  output       = "../generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

model User {
  id        String   @id @default(uuid())
  name      String
  email     String   @unique
  password  String
  role      Role     @default(USER)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("users")
}

enum Role {
  ADMIN
  USER
}

model Client {
  id             String         @id @default(uuid())
  type           ClientType     @default(INDIVIDUAL)
  name           String
  document       String         @unique
  email          String?
  phone          String?
  address        String?
  city           String?
  state          String?
  zipCode        String?
  notes          String?
  budgets        Budget[]
  workSites      WorkSite[]
  projects       Project[]
  financeEntries FinanceEntry[]
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  @@map("clients")
}

enum ClientType {
  INDIVIDUAL
  COMPANY
}

model Material {
  id             String               @id @default(uuid())
  code           String?              @unique
  name           String
  category       String
  unit           String
  unitCost       Decimal              @db.Decimal(12, 2)
  supplier       String?
  budgetItems    BudgetMaterialItem[]
  stockItem      StockItem?
  purchaseItems  PurchaseOrderItem[]
  surpluses      MaterialSurplus[]
  quotationItems QuotationItem[]
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt

  @@map("materials")
}

model LaborRole {
  id          String            @id @default(uuid())
  name        String            @unique
  hourlyRate  Decimal           @db.Decimal(12, 2)
  chargesPct  Decimal           @default(0) @db.Decimal(5, 2)
  budgetItems BudgetLaborItem[]
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  @@map("labor_roles")
}

model Vehicle {
  id               String               @id @default(uuid())
  name             String
  plate            String               @unique
  type             String
  fuelType         String
  avgConsumption   Decimal              @db.Decimal(6, 2)
  initialKm        Decimal              @default(0) @db.Decimal(10, 2)
  currentKm        Decimal              @default(0) @db.Decimal(10, 2)
  reviewIntervalKm Decimal?             @db.Decimal(10, 2)
  budgetItems      BudgetTravelItem[]
  workLogUsages    WorkLogVehicle[]
  trips            VehicleTrip[]
  maintenances     VehicleMaintenance[]
  financeEntries   FinanceEntry[]
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt

  @@map("vehicles")
}

model VehicleTrip {
  id          String    @id @default(uuid())
  vehicleId   String
  vehicle     Vehicle   @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  driverId    String?
  driver      Employee? @relation(fields: [driverId], references: [id])
  projectId   String?
  project     Project?  @relation(fields: [projectId], references: [id])
  origin      String
  destination String
  purpose     String?
  distanceKm  Decimal   @db.Decimal(10, 2)
  date        DateTime  @default(now())
  notes       String?
  createdAt   DateTime  @default(now())

  @@map("vehicle_trips")
}

model VehicleMaintenance {
  id             String        @id @default(uuid())
  vehicleId      String
  vehicle        Vehicle       @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  date           DateTime
  km             Decimal       @db.Decimal(10, 2)
  type           String
  cost           Decimal       @db.Decimal(12, 2)
  description    String?
  supplierName   String?
  financeEntryId String?       @unique
  financeEntry   FinanceEntry? @relation(fields: [financeEntryId], references: [id])
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@map("vehicle_maintenances")
}

enum BudgetStatus {
  DRAFT
  SENT
  APPROVED
  REJECTED
  NEGOTIATING
}

enum TaxRegime {
  SIMPLES
  LUCRO_PRESUMIDO
  LUCRO_REAL
  MEI
}

model Budget {
  id             String               @id @default(uuid())
  number         String               @unique
  clientId       String
  client         Client               @relation(fields: [clientId], references: [id])
  description    String?
  status         BudgetStatus         @default(DRAFT)
  regime         TaxRegime            @default(SIMPLES)
  bdiPct         Decimal              @default(20) @db.Decimal(5, 2)
  discountPct    Decimal              @default(0) @db.Decimal(5, 2)
  notes          String?
  employeeId     String?
  employee       Employee?            @relation(fields: [employeeId], references: [id])
  materialItems  BudgetMaterialItem[]
  laborItems     BudgetLaborItem[]
  travelItems    BudgetTravelItem[]
  otherItems     BudgetOtherItem[]
  project        Project?
  financeEntries FinanceEntry[]
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt

  @@map("budgets")
}

model BudgetMaterialItem {
  id         String   @id @default(uuid())
  budgetId   String
  budget     Budget   @relation(fields: [budgetId], references: [id], onDelete: Cascade)
  materialId String
  material   Material @relation(fields: [materialId], references: [id])
  quantity   Decimal  @db.Decimal(12, 2)
  unitCost   Decimal  @db.Decimal(12, 2)

  @@map("budget_material_items")
}

model BudgetLaborItem {
  id          String    @id @default(uuid())
  budgetId    String
  budget      Budget    @relation(fields: [budgetId], references: [id], onDelete: Cascade)
  laborRoleId String
  laborRole   LaborRole @relation(fields: [laborRoleId], references: [id])
  hours       Decimal   @db.Decimal(8, 2)
  hourlyRate  Decimal   @db.Decimal(12, 2)

  @@map("budget_labor_items")
}

model BudgetTravelItem {
  id         String  @id @default(uuid())
  budgetId   String
  budget     Budget  @relation(fields: [budgetId], references: [id], onDelete: Cascade)
  vehicleId  String
  vehicle    Vehicle @relation(fields: [vehicleId], references: [id])
  distanceKm Decimal @db.Decimal(10, 2)
  trips      Int
  fuelPrice  Decimal @db.Decimal(8, 2)

  @@map("budget_travel_items")
}

model BudgetOtherItem {
  id          String  @id @default(uuid())
  budgetId    String
  budget      Budget  @relation(fields: [budgetId], references: [id], onDelete: Cascade)
  description String
  amount      Decimal @db.Decimal(12, 2)

  @@map("budget_other_items")
}

model WorkSite {
  id         String    @id @default(uuid())
  name       String
  clientId   String
  client     Client    @relation(fields: [clientId], references: [id])
  address    String
  city       String?
  state      String?
  distanceKm Decimal?  @db.Decimal(10, 2)
  notes      String?
  projects   Project[]
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@map("work_sites")
}

enum ProjectStatus {
  PLANNING
  IN_PROGRESS
  ON_HOLD
  COMPLETED
  CANCELLED
}

model Project {
  id                     String               @id @default(uuid())
  number                 String               @unique
  name                   String
  clientId               String
  client                 Client               @relation(fields: [clientId], references: [id])
  workSiteId             String?
  workSite               WorkSite?            @relation(fields: [workSiteId], references: [id])
  budgetId               String?              @unique
  budget                 Budget?              @relation(fields: [budgetId], references: [id])
  status                 ProjectStatus        @default(PLANNING)
  budgetAmount           Decimal              @default(0) @db.Decimal(12, 2)
  startDate              DateTime?
  endDate                DateTime?
  notes                  String?
  responsibleEmployeeId  String?
  responsibleEmployee    Employee?            @relation(fields: [responsibleEmployeeId], references: [id])
  toolsCurrentlyHere     Tool[]
  toolMovements          ToolMovement[]
  stockMovements         StockMovement[]
  workLogs               WorkLog[]
  tasks                  Task[]
  financeEntries         FinanceEntry[]
  billingItems           ProjectBillingItem[]
  vehicleTrips           VehicleTrip[]
  materialSurpluses      MaterialSurplus[]
  directedPurchaseOrders PurchaseOrder[]
  createdAt              DateTime             @default(now())
  updatedAt              DateTime             @updatedAt

  @@map("projects")
}

enum ToolLocation {
  COMPANY
  PROJECT
}

model Tool {
  id               String            @id @default(uuid())
  code             String?           @unique
  name             String
  category         String
  currentLocation  ToolLocation      @default(COMPANY)
  currentProjectId String?
  currentProject   Project?          @relation(fields: [currentProjectId], references: [id])
  notes            String?
  movements        ToolMovement[]
  workLogUsages    WorkLogTool[]
  maintenances     ToolMaintenance[]
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  financeEntries   FinanceEntry[]

  @@map("tools")
}

model ToolMaintenance {
  id             String        @id @default(uuid())
  toolId         String
  tool           Tool          @relation(fields: [toolId], references: [id], onDelete: Cascade)
  date           DateTime
  type           String
  cost           Decimal       @db.Decimal(12, 2)
  description    String?
  supplierName   String?
  financeEntryId String?       @unique
  financeEntry   FinanceEntry? @relation(fields: [financeEntryId], references: [id])
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@map("tool_maintenances")
}

model ToolMovement {
  id           String       @id @default(uuid())
  toolId       String
  tool         Tool         @relation(fields: [toolId], references: [id], onDelete: Cascade)
  fromLocation ToolLocation
  toLocation   ToolLocation
  projectId    String?
  project      Project?     @relation(fields: [projectId], references: [id])
  responsible  String?
  notes        String?
  movedAt      DateTime     @default(now())

  @@map("tool_movements")
}

enum StockMovementType {
  IN
  OUT
}

model StockItem {
  id          String          @id @default(uuid())
  materialId  String          @unique
  material    Material        @relation(fields: [materialId], references: [id])
  quantity    Decimal         @default(0) @db.Decimal(12, 2)
  minQuantity Decimal         @default(0) @db.Decimal(12, 2)
  movements   StockMovement[]
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  @@map("stock_items")
}

model StockMovement {
  id          String            @id @default(uuid())
  stockItemId String
  stockItem   StockItem         @relation(fields: [stockItemId], references: [id], onDelete: Cascade)
  type        StockMovementType
  quantity    Decimal           @db.Decimal(12, 2)
  projectId   String?
  project     Project?          @relation(fields: [projectId], references: [id])
  notes       String?
  movedAt     DateTime          @default(now())

  @@map("stock_movements")
}

model WorkLog {
  id            String            @id @default(uuid())
  projectId     String
  project       Project           @relation(fields: [projectId], references: [id], onDelete: Cascade)
  date          DateTime
  weather       String?
  description   String
  occurrences   String?
  noTravel      Boolean           @default(false)
  employees     WorkLogEmployee[]
  vehicleUsages WorkLogVehicle[]
  toolsUsed     WorkLogTool[]
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  @@map("work_logs")
}

model WorkLogEmployee {
  id         String   @id @default(uuid())
  workLogId  String
  workLog    WorkLog  @relation(fields: [workLogId], references: [id], onDelete: Cascade)
  employeeId String
  employee   Employee @relation(fields: [employeeId], references: [id])

  @@map("work_log_employees")
}

model WorkLogVehicle {
  id        String    @id @default(uuid())
  workLogId String
  workLog   WorkLog   @relation(fields: [workLogId], references: [id], onDelete: Cascade)
  vehicleId String
  vehicle   Vehicle   @relation(fields: [vehicleId], references: [id])
  driverId  String?
  driver    Employee? @relation(fields: [driverId], references: [id])

  @@map("work_log_vehicles")
}

model WorkLogTool {
  id        String  @id @default(uuid())
  workLogId String
  workLog   WorkLog @relation(fields: [workLogId], references: [id], onDelete: Cascade)
  toolId    String
  tool      Tool    @relation(fields: [toolId], references: [id])

  @@map("work_log_tools")
}

model Supplier {
  id                 String              @id @default(uuid())
  name               String
  document           String?             @unique
  phone              String?
  email              String?
  address            String?
  notes              String?
  purchaseOrders     PurchaseOrder[]
  financeEntries     FinanceEntry[]
  quotationProposals QuotationProposal[]
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt

  @@map("suppliers")
}

enum PurchaseOrderStatus {
  PENDING
  RECEIVED
  CANCELLED
}

model PurchaseOrder {
  id                   String              @id @default(uuid())
  number               String              @unique
  supplierId           String
  supplier             Supplier            @relation(fields: [supplierId], references: [id])
  status               PurchaseOrderStatus @default(PENDING)
  notes                String?
  requestedBy          String?
  destinationProjectId String?
  destinationProject   Project?            @relation(fields: [destinationProjectId], references: [id])
  items                PurchaseOrderItem[]
  financeEntries       FinanceEntry[]
  receivedAt           DateTime?
  createdAt            DateTime            @default(now())
  updatedAt            DateTime            @updatedAt

  @@map("purchase_orders")
}

model PurchaseOrderItem {
  id              String        @id @default(uuid())
  purchaseOrderId String
  purchaseOrder   PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  materialId      String
  material        Material      @relation(fields: [materialId], references: [id])
  quantity        Decimal       @db.Decimal(12, 2)
  unitCost        Decimal       @db.Decimal(12, 2)

  @@map("purchase_order_items")
}

enum SurplusStatus {
  PENDING
  RETURNED_TO_STOCK
  KEPT_AT_PROJECT
}

model MaterialSurplus {
  id         String        @id @default(uuid())
  projectId  String
  project    Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  materialId String
  material   Material      @relation(fields: [materialId], references: [id])
  quantity   Decimal       @db.Decimal(12, 2)
  status     SurplusStatus @default(PENDING)
  notes      String?
  resolvedAt DateTime?
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt

  @@map("material_surpluses")
}

enum QuotationStatus {
  OPEN
  CLOSED
}

model Quotation {
  id          String          @id @default(uuid())
  number      String          @unique
  description String?
  status      QuotationStatus @default(OPEN)
  items       QuotationItem[]
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  @@map("quotations")
}

model QuotationItem {
  id          String              @id @default(uuid())
  quotationId String
  quotation   Quotation           @relation(fields: [quotationId], references: [id], onDelete: Cascade)
  materialId  String
  material    Material            @relation(fields: [materialId], references: [id])
  quantity    Decimal             @db.Decimal(12, 2)
  proposals   QuotationProposal[]

  @@map("quotation_items")
}

model QuotationProposal {
  id              String        @id @default(uuid())
  quotationItemId String
  quotationItem   QuotationItem @relation(fields: [quotationItemId], references: [id], onDelete: Cascade)
  supplierId      String
  supplier        Supplier      @relation(fields: [supplierId], references: [id])
  unitCost        Decimal       @db.Decimal(12, 2)
  isWinner        Boolean       @default(false)
  notes           String?
  createdAt       DateTime      @default(now())

  @@map("quotation_proposals")
}

model Settings {
  id                String    @id @default(uuid())
  companyName       String    @default("")
  companyDocument   String?
  companyIe         String?
  companyAddress    String?
  companyPhone      String?
  companyEmail      String?
  defaultRegime     TaxRegime @default(SIMPLES)
  defaultBdiPct     Decimal   @default(20) @db.Decimal(5, 2)
  defaultChargesPct Decimal   @default(0) @db.Decimal(5, 2)
  defaultFuelPrice  Decimal   @default(6) @db.Decimal(8, 2)
  budgetPrefix      String    @default("ORC")
  projectPrefix     String    @default("PRJ")
  marginHealthyPct  Decimal   @default(20) @db.Decimal(5, 2)
  marginWarningPct  Decimal   @default(10) @db.Decimal(5, 2)
  updatedAt         DateTime  @updatedAt

  @@map("settings")
}

enum CnhType {
  A
  B
  C
  D
  E
}

model Employee {
  id                  String            @id @default(uuid())
  name                String
  role                String
  dailyRate           Decimal           @db.Decimal(12, 2)
  cnhTypes            CnhType[]         @default([])
  phone               String?
  active              Boolean           @default(true)
  eppDeliveries       EppDelivery[]
  trainings           Training[]
  workLogEntries      WorkLogEmployee[]
  drivenLogs          WorkLogVehicle[]
  vehicleTrips        VehicleTrip[]
  budgets             Budget[]
  responsibleProjects Project[]
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt

  @@map("employees")
}

model EppDelivery {
  id          String   @id @default(uuid())
  employeeId  String
  employee    Employee @relation(fields: [employeeId], references: [id])
  itemName    String
  deliveredAt DateTime @default(now())
  signed      Boolean  @default(false)
  notes       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("epp_deliveries")
}

model DdsRecord {
  id           String   @id @default(uuid())
  date         DateTime
  topic        String
  participants String[]
  notes        String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@map("dds_records")
}

model Training {
  id          String    @id @default(uuid())
  employeeId  String
  employee    Employee  @relation(fields: [employeeId], references: [id])
  nrType      String
  completedAt DateTime
  expiresAt   DateTime?
  notes       String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@map("trainings")
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  DONE
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

model Task {
  id          String       @id @default(uuid())
  title       String
  description String?
  status      TaskStatus   @default(TODO)
  priority    TaskPriority @default(MEDIUM)
  dueDate     DateTime?
  projectId   String?
  project     Project?     @relation(fields: [projectId], references: [id])
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@map("tasks")
}

enum FinanceEntryType {
  INCOME
  EXPENSE
}

enum FinanceEntryStatus {
  PENDING
  PAID
  CANCELLED
}

model FinanceCategory {
  id        String           @id @default(uuid())
  name      String
  type      FinanceEntryType
  entries   FinanceEntry[]
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  @@unique([name, type])
  @@map("finance_categories")
}

model FinanceEntry {
  id              String              @id @default(uuid())
  type            FinanceEntryType
  description     String
  categoryId      String
  category        FinanceCategory     @relation(fields: [categoryId], references: [id])
  amount          Decimal             @db.Decimal(12, 2)
  dueDate         DateTime
  paidAt          DateTime?
  paidAmount      Decimal?            @db.Decimal(12, 2)
  status          FinanceEntryStatus  @default(PENDING)
  projectId       String?
  project         Project?            @relation(fields: [projectId], references: [id])
  supplierId      String?
  supplier        Supplier?           @relation(fields: [supplierId], references: [id])
  clientId        String?
  client          Client?             @relation(fields: [clientId], references: [id])
  purchaseOrderId String?
  purchaseOrder   PurchaseOrder?      @relation(fields: [purchaseOrderId], references: [id])
  budgetId        String?
  budget          Budget?             @relation(fields: [budgetId], references: [id])
  vehicleId       String?
  vehicle         Vehicle?            @relation(fields: [vehicleId], references: [id])
  toolId          String?
  tool            Tool?               @relation(fields: [toolId], references: [id])
  billingItem     ProjectBillingItem?
  maintenance     VehicleMaintenance?
  toolMaintenance ToolMaintenance?
  notes           String?
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt

  @@map("finance_entries")
}

enum ProjectBillingStatus {
  PLANNED
  INVOICED
  CANCELLED
}

model ProjectBillingItem {
  id             String               @id @default(uuid())
  projectId      String
  project        Project              @relation(fields: [projectId], references: [id], onDelete: Cascade)
  description    String
  amount         Decimal              @db.Decimal(12, 2)
  plannedDate    DateTime
  status         ProjectBillingStatus @default(PLANNED)
  financeEntryId String?              @unique
  financeEntry   FinanceEntry?        @relation(fields: [financeEntryId], references: [id])
  notes          String?
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt

  @@map("project_billing_items")
}

model CalendarEvent {
  id          String   @id @default(uuid())
  title       String
  date        DateTime
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("calendar_events")
}
