  @@index([createdAt])
  @@index([action])
  @@map("audit_logs")
}

model Playbook {
  id                 String   @id @default(uuid())
  code               String?
  title              String
  category           String
  objective          String?
  executor           String?
  requirements       String?
  steps              String[] @default([])
  acceptanceCriteria String?
  commonErrors       String?
  standardTime       String?
  compositionId      String?
  compositionLabel   String?
  version            Int      @default(1)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

