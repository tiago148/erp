generator client {
  provider     = "prisma-client"
  output       = "../generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

model User {
  id        String   @id @default(uuid())
  name      String
  email     String   @unique
  password  String
  role      Role     @default(USER)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("users")
}

enum Role {
  ADMIN
  USER
}

model Client {
  id        String      @id @default(uuid())
  type      ClientType  @default(INDIVIDUAL)
  name      String
  document  String      @unique
  email     String?
  phone     String?
  address   String?
  city      String?
  state     String?
  zipCode   String?
  notes     String?
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  @@map("clients")
}

enum ClientType {
  INDIVIDUAL
  COMPANY
}
model Material {
  id        String   @id @default(uuid())
  code      String?  @unique
  name      String
  category  String
  unit      String
  unitCost  Decimal  @db.Decimal(12, 2)
  supplier  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("materials")
}
model LaborRole {
  id          String   @id @default(uuid())
  name        String   @unique
  hourlyRate  Decimal  @db.Decimal(12, 2)
  chargesPct  Decimal  @db.Decimal(5, 2) @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("labor_roles")
}
model Vehicle {
  id             String   @id @default(uuid())
  name           String
  plate          String   @unique
  type           String
  fuelType       String
  avgConsumption Decimal  @db.Decimal(6, 2)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@map("vehicles")
}